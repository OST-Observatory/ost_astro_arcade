; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OST Astro Arcade"
config/description="Touch kiosk with astronomy games of the OST observatory, Universität Potsdam"
run/main_scene="res://hub/hub.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://core/settings.gd"
I18n="*res://core/i18n.gd"
Audio="*res://core/audio.gd"
Session="*res://core/session.gd"
Telemetry="*res://core/telemetry.gd"
Scores="*res://core/scores.gd"
Kiosk="*res://core/kiosk.gd"
Router="*res://core/router.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[internationalization]

locale/translations=PackedStringArray("res://locale/ui.de.translation", "res://locale/ui.en.translation", "res://locale/ui.es.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
